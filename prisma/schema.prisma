// Vahti AI · tietomalli.
// Kentät on nimetty toimeksiannon mukaisesti (turkinkieliset tunnisteet).
// Görev 7: pgvector-laajennus + embedding-sarake (RAG).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Klinikka (tenant).
model Klinik {
  id               String   @id @default(cuid())
  slug             String?  @unique // jaettava puhelulinkki: /call/<slug>  (GÖREV B)
  ad               String
  email            String   @unique
  telefon          String?
  varayhteysNumero String? // PSTN-varayhteys (GÖREV C)
  sehir            String?
  ulke             String   @default("FI")
  sektor           String?
  aiDili           String   @default("fi")
  saatDilimi       String   @default("Europe/Helsinki")
  plan             String   @default("essential")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  kullanicilar     Kullanici[]
  leadler          Lead[]
  tietopankki      KnowledgeEntry[]
  ajanvaraukset    Appointment[]
  callbackPyynnot  CallbackRequest[]
  kullanimLoglar   UsageLog[]
}

/// GÖREV A — selaimen puhelu-widgetistä jätetty yhteydenottopyyntö.
model CallbackRequest {
  id             String   @id @default(cuid())
  klinikId       String
  nimi           String
  email          String?
  puhelin        String?
  aihe           String? // aihe/otsikko
  viesti         String
  tapa           String   @default("teksti") // teksti | aani
  lahde          String   @default("widget") // widget | call-link
  tila           String   @default("uusi") // uusi | kasitelty
  assignedToId   String? // GÖREV E — round-robin -vastuuhenkilö
  assignedToNimi String? // denormalisoitu nimi näyttöä varten
  createdAt      DateTime @default(now())

  klinik Klinik @relation(fields: [klinikId], references: [id], onDelete: Cascade)

  @@index([klinikId, createdAt])
}

/// Klinikan käyttäjä (tiimin jäsen) + kirjautumistiedot (GÖREV C).
model Kullanici {
  id           String   @id @default(cuid())
  klinikId     String?
  ad           String
  email        String   @unique
  rol          String   @default("uye")
  passwordHash String? // bcrypt-tiiviste (Credentials-kirjautuminen)
  createdAt    DateTime @default(now())

  klinik Klinik? @relation(fields: [klinikId], references: [id], onDelete: SetNull)

  @@index([klinikId])
}

/// Liidi (mahdollinen potilas).
model Lead {
  id              String    @id @default(cuid())
  klinikId        String
  isim            String?
  dil             String    @default("fi")
  kaynakKanal     String    @default("web_chat")
  leadSkoru       Int       @default(0)
  pipelineAsamasi String    @default("uusi")
  // Yhteystiedot automaatioita varten (Görev 8):
  puhelin         String?
  email           String?
  sonYhteysAika   DateTime? // viimeisin kontakti
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  klinik       Klinik        @relation(fields: [klinikId], references: [id], onDelete: Cascade)
  konusmalar   Konusma[]
  ajanvaraukset Appointment[]

  @@index([klinikId])
  @@index([klinikId, pipelineAsamasi])
}

/// Keskustelu yhden kanavan kautta; viestit talletetaan JSON-listana.
model Konusma {
  id        String   @id @default(cuid())
  leadId    String
  kanal     String
  mesajlar  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// Görev 7 — tietopankin tietue + embedding (pgvector).
/// `embedding` on Unsupported-tyyppi: sitä käsitellään raakakyselyillä
/// ($queryRaw / $executeRaw), ei Prisma Clientin kautta.
model KnowledgeEntry {
  id        String   @id @default(cuid())
  klinikId  String
  palvelu   String
  kategoria String
  hinta     String   @default("")
  kesto     String   @default("")
  tiedot    String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  klinik Klinik @relation(fields: [klinikId], references: [id], onDelete: Cascade)

  @@index([klinikId])
}

/// Görev 6 — paikallinen kopio Google Calendar -varauksesta.
model Appointment {
  id              String   @id @default(cuid())
  klinikId        String
  leadId          String?
  potilaanNimi    String
  palvelu         String
  alkaa           DateTime
  yhteystieto     String?
  calendarEventId String? // Google Calendar -tapahtuman id (jos luotu)
  lahde           String   @default("agent") // agent | manual | voice | whatsapp
  muistutettu     Boolean  @default(false)
  createdAt       DateTime @default(now())

  klinik Klinik @relation(fields: [klinikId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([klinikId])
  @@index([alkaa])
}

/// GÖREV C — käyttö-/kustannusseurannan loki (ääni-AI minuutit, WhatsApp- ja
/// chat-viestit). `tip`: "ses" | "whatsapp" | "chat". `miktar`: minuutit (ses)
/// tai kappalemäärä (whatsapp/chat). Kuukausisumma lasketaan lib/usage.ts:ssä.
model UsageLog {
  id       String   @id @default(cuid())
  klinikId String
  tip      String
  miktar   Float
  tarih    DateTime @default(now())

  klinik Klinik @relation(fields: [klinikId], references: [id], onDelete: Cascade)

  @@index([klinikId, tip, tarih])
}

/// Görev 8 — automaatioajojen loki.
model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  executedAt DateTime @default(now())
  dryRun     Boolean  @default(false)
  matched    Int      @default(0)
  sent       Int      @default(0)
  detail     Json     @default("{}")

  @@index([workflowId, executedAt])
}

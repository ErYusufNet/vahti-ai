# ============================================================================
# Vahti AI — ympäristömuuttujat
# Kopioi tämä tiedosto nimellä ".env" ja täytä arvot:
#   cp .env.example .env
# ============================================================================

# --- Claude API (Anthropic) ------------------------------------------------
# Hae avain: https://console.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Tietokanta (PostgreSQL / Prisma) ------------------------------------
# Muoto: postgresql://KAYTTAJA:SALASANA@HOST:PORTTI/TIETOKANTA?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vahti_ai?schema=public

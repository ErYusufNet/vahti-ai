# ============================================================================
# Vahti AI — ympäristömuuttujat
# Kopioi:  cp .env.example .env
#
# TÄRKEÄÄ: sovellus toimii ILMAN kaikkia näitä. Jokainen integraatio menee
# "demo/mock"-tilaan, jos sen avain puuttuu, eikä kaada järjestelmää.
# Kun täytät avaimen, kyseinen integraatio siirtyy automaattisesti oikeaan
# tilaan (näkyy /api/integrations ja Asetukset-sivulla).
# ============================================================================

# --- Sovellus -------------------------------------------------------------
APP_BASE_URL=http://localhost:3000     # julkinen URL (webhookit + ääni <Play>)
ENABLE_CRON=true                        # false = älä käynnistä työnkulkujen ajastinta

# --- Tietokanta (Prisma / PostgreSQL + pgvector) ------------------------
# Tarvitaan tallennukseen (keskustelut, liidit, ajanvaraukset, tietopankki).
# Ilman tätä dashboard näyttää mock-datan.
#   1) käynnistä Postgres (pgvector mukana):
#      docker run --name vahti-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=vahti_ai \
#        -p 5432:5432 -d pgvector/pgvector:pg16
#   2) npm run db:push
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vahti_ai?schema=public

# --- Görev 2: Claude API (Anthropic) -----------------------------------
# Ilman tätä agentti käyttää sääntöpohjaisia mock-vastauksia.
# Hae: https://console.anthropic.com  →  Settings  →  API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Görev 5: WhatsApp Business Cloud API (Meta) --------------------
# Ilman näitä: webhook toimii, agentti ajetaan, mutta vastausta ei lähetetä
# (kirjataan konsoliin).
# Hae: https://developers.facebook.com  →  luo sovellus  →  lisää "WhatsApp"
WHATSAPP_VERIFY_TOKEN=                  # oma satunnainen merkkijono (webhookin verify)
WHATSAPP_TOKEN=                         # Graph API -token (System User -token suositeltu)
WHATSAPP_PHONE_ID=                      # WhatsApp-numeron Phone number ID
WHATSAPP_APP_SECRET=                    # (valinnainen) X-Hub-Signature-256 -tarkistus
WHATSAPP_API_VERSION=v21.0

# --- Görev 6: Google Calendar API ---------------------------------
# Ilman näitä: agentin "create_appointment" palauttaa demo-tapahtuman.
# Hae: https://console.cloud.google.com → APIs & Services → ota "Calendar API"
#      käyttöön → luo OAuth 2.0 -tunnukset → hae refresh token (OAuth Playground)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Görev 7: Embeddingit (RAG) ------------------------------------
# Ilman näitä: tietopankin haku toimii avainsanoilla (ei vektorihakua).
EMBEDDING_PROVIDER=openai               # openai | voyage
OPENAI_API_KEY=                         # https://platform.openai.com/api-keys  (text-embedding-3-small)
VOYAGE_API_KEY=                         # vaihtoehto: https://www.voyageai.com/  (voyage-3)

# --- Görev 9: Sesli AI (Twilio + Deepgram + ElevenLabs) ------------
# Ilman näitä: webhookit palauttavat validia TwiML:ää, mutta puhelua ei voi
# vastaanottaa ilman Twilio-numeroa + julkista APP_BASE_URL:ia.
# Twilio:     https://console.twilio.com  (Account SID, Auth Token, osta numero)
# Deepgram:   https://console.deepgram.com  (STT, nova-2, suomi) — puuttuessa
#             käytetään Twilion omaa <Gather input="speech"> -tunnistusta.
# ElevenLabs: https://elevenlabs.io  (TTS, multilingual) — puuttuessa Twilion <Say>.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

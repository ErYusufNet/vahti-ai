# ============================================================================
# Vahti AI — ympäristömuuttujat
# Kopioi:  cp .env.example .env   ja täytä tarpeen mukaan.
# Dashboard toimii ILMAN mitään näistä (mock-data). Avaimet kytkevät oikeat
# integraatiot päälle.
# ============================================================================

# --- Görev 1: Tietokanta (Prisma / PostgreSQL) --------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vahti_ai?schema=public

# --- Görev 2: Claude API (Anthropic) -------------------------------------
# Ilman tätä /api/chat ja testinäyttö toimivat mock-tilassa.
# Hae avain: https://console.anthropic.com  →  Settings  →  API Keys
ANTHROPIC_API_KEY=
# Malli (oletus claude-sonnet-5, spec Görev 2):
ANTHROPIC_MODEL=claude-sonnet-5

# --- Görev 5: WhatsApp Business Cloud API (Meta) -----------------------
# https://developers.facebook.com  →  luo sovellus  →  lisää "WhatsApp"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Görev 6: Google Calendar API -------------------------------------
# https://console.cloud.google.com  →  APIs & Services  →  Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Görev 7: RAG / embeddingit --------------------------------------
# Voyage AI (Anthropic suosittelee):  https://www.voyageai.com/
VOYAGE_API_KEY=

# --- Görev 8: Automaatiot (jono) — valinnainen ------------------------
# Vain jos käytät BullMQ:ta node-cronin sijaan:
REDIS_URL=

# --- Görev 9: Ääni-/puhelukanava -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
